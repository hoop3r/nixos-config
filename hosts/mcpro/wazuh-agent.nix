# Wazuh agent on mcpro, enrolling against the manager on hoophq.
#
# WHY THIS IS NOT THE FLAKE MODULE
# github:nealfennimore/wazuh-nixos -- which runs the whole server stack on
# hoophq, see ../hoophq/wazuh.nix -- has NO darwin outputs. Its flake declares
# x86_64-linux and aarch64-linux only, and services.wazuh-agent is built on
# systemd units, a journald localfile reader and a nix-store package-inventory
# collector. None of that ports. So this host installs the official upstream
# .pkg instead, and this module makes that as declarative as a .pkg can be:
#
#   * the package is pinned by version AND hash via pkgs.fetchurl, so an
#     upgrade is a two-line edit here and nothing is ever "whatever was on
#     packages.wazuh.com that day";
#   * ossec.conf is generated from this file, so the agent's configuration is
#     reviewable in git rather than edited in place on the laptop;
#   * the installer runs from activation only when the installed version does
#     not match the pin, and the daemon is restarted only when a file it reads
#     actually changed.
#
# What stays imperative: the .pkg's own preinstall/postinstall (they create the
# wazuh user and group with dscl, generate SCA policy files and chown
# /Library/Ossec), and the two secret files listed under MANUAL SETUP below.
#
# VERSION PARITY MATTERS. 4.14.10 here matches pkgs/common/default.nix in the
# wazuh flake -- same upstream commit, 6e7835b, which VERSION.json inside this
# .pkg also reports. An agent NEWER than its manager is not a supported
# combination, so bump hoophq first and this second, never the other way round.
#
# MANUAL SETUP, once, as root on mcpro. Nix cannot do either of these: the
# first is a secret that sops does not manage on this host (there is no age key
# here), the second is generated on hoophq at first boot.
#
#   sudo mkdir -p /etc/wazuh && sudo chmod 0700 /etc/wazuh
#
#   # 1. the enrollment password -- AUTHD_PASS from hoophq's sops store:
#   #      hoophq$ sops -d hosts/hoophq/secrets/wazuh.yaml | grep AUTHD_PASS
#   sudo tee /etc/wazuh/authd.pass           # paste the value, no trailing spaces
#   sudo chmod 0600 /etc/wazuh/authd.pass
#
#   # 2. the CA that signed the manager's authd certificate. hoophq's
#   #    wazuh-pki.service drops a readable copy here for exactly this:
#   scp hoophq:/var/lib/wazuh-ca/ca.pem /tmp/wazuh-ca.pem
#   sudo mv /tmp/wazuh-ca.pem /etc/wazuh/wazuh-ca.pem
#   sudo chmod 0644 /etc/wazuh/wazuh-ca.pem
#
# Activation warns and carries on if either is missing -- the agent installs
# fine, it just cannot enroll until they are there.
#
# AND ONE THING NIX CANNOT DO AT ALL: macOS TCC. Grant Full Disk Access to
#   /Library/Ossec/bin/wazuh-modulesd
#   /Library/Ossec/bin/wazuh-logcollector
# in System Settings > Privacy & Security > Full Disk Access (or by MDM
# profile). Without it the agent enrolls, reports and looks healthy while
# silently failing to read TCC-protected paths, which is the worst of the
# available failure modes. There is no CLI for this.
{
  config,
  pkgs,
  lib,
  ...
}:
let
  # Bump both together; get the hash with
  #   nix store prefetch-file https://packages.wazuh.com/4.x/macos/wazuh-agent-<rel>.arm64.pkg
  version = "4.14.10";
  release = "4.14.10-1";

  # arm64, because mcpro is aarch64-darwin. The intel64 build is a different
  # file and a different hash.
  agentPkg = pkgs.fetchurl {
    url = "https://packages.wazuh.com/4.x/macos/wazuh-agent-${release}.arm64.pkg";
    hash = "sha256-G1Khh3CM77y4LArYKLQjxrXD3S19hSFqnNhf/+XSg10=";
  };

  # MagicDNS, not the raw 100.124.247.94, because the manager's authd
  # certificate carries this name in its SAN and enrollment verifies it. The
  # IP is in that SAN too, so swapping to it works if MagicDNS ever misbehaves
  # -- but then this agent only reaches hoophq over the tailnet either way.
  managerHost = "hoophq.tail072ce1.ts.net";
  agentName = "mcpro";

  ossecDir = "/Library/Ossec";
  stagedCa = "/etc/wazuh/wazuh-ca.pem";
  stagedPass = "/etc/wazuh/authd.pass";

  # Generated ossec.conf. The .pkg's postinstall writes its own via
  # gen_ossec.sh on a fresh install and restores the previous one on an
  # upgrade; either way activation overwrites it with this, after the
  # installer has run.
  ossecConf = pkgs.writeText "mcpro-ossec.conf" ''
    <!-- Generated by hosts/mcpro/wazuh-agent.nix. Do not edit in place: the
         next darwin-rebuild switch will overwrite it. -->
    <ossec_config>

      <client>
        <server>
          <address>${managerHost}</address>
          <port>1514</port>
          <protocol>tcp</protocol>
        </server>
        <config-profile>darwin</config-profile>
        <notify_time>10</notify_time>
        <time-reconnect>60</time-reconnect>
        <auto_restart>yes</auto_restart>
        <crypto_method>aes</crypto_method>

        <!-- Password enrollment against authd on 1515. server_ca_path is what
             makes this agent verify the manager rather than trusting whatever
             answers on that port; it is the CA staged by hand per the header.
             authorization_pass_path is relative to /Library/Ossec. -->
        <enrollment>
          <enabled>yes</enabled>
          <manager_address>${managerHost}</manager_address>
          <port>1515</port>
          <agent_name>${agentName}</agent_name>
          <authorization_pass_path>etc/authd.pass</authorization_pass_path>
          <server_ca_path>${ossecDir}/etc/wazuh-ca.pem</server_ca_path>
        </enrollment>
      </client>

      <client_buffer>
        <disabled>no</disabled>
        <queue_size>5000</queue_size>
        <events_per_second>500</events_per_second>
      </client_buffer>

      <!-- Off. Active response means the manager can execute scripts here, and
           nothing in this deployment needs that from a laptop. -->
      <active-response>
        <disabled>yes</disabled>
      </active-response>

      <rootcheck>
        <disabled>no</disabled>
        <check_files>yes</check_files>
        <check_trojans>yes</check_trojans>
        <check_dev>yes</check_dev>
        <check_sys>yes</check_sys>
        <check_pids>yes</check_pids>
        <check_ports>yes</check_ports>
        <check_if>yes</check_if>
        <frequency>43200</frequency>
        <rootkit_files>etc/shared/rootkit_files.txt</rootkit_files>
        <rootkit_trojans>etc/shared/rootkit_trojans.txt</rootkit_trojans>
        <skip_nfs>yes</skip_nfs>
      </rootcheck>

      <wodle name="syscollector">
        <disabled>no</disabled>
        <interval>1h</interval>
        <scan_on_start>yes</scan_on_start>
        <hardware>yes</hardware>
        <os>yes</os>
        <network>yes</network>
        <packages>yes</packages>
        <ports all="no">yes</ports>
        <processes>yes</processes>
      </wodle>

      <sca>
        <enabled>yes</enabled>
        <scan_on_start>yes</scan_on_start>
        <interval>12h</interval>
        <skip_nfs>yes</skip_nfs>
      </sca>

      <syscheck>
        <disabled>no</disabled>
        <frequency>43200</frequency>
        <scan_on_start>yes</scan_on_start>

        <!-- The upstream macOS defaults. /usr/bin and /usr/sbin are large but
             SIP-protected, so a change in them is worth an alert. -->
        <directories check_all="yes">/etc,/usr/bin,/usr/sbin</directories>
        <directories check_all="yes">/bin,/sbin</directories>

        <!-- Added, and the most useful part of this block on a Mac: these are
             where persistence lives. realtime so it alerts on write rather
             than up to twelve hours later. -->
        <directories check_all="yes" realtime="yes">/Library/LaunchDaemons,/Library/LaunchAgents</directories>
        <directories check_all="yes">/Applications</directories>

        <ignore>/etc/mnttab</ignore>
        <ignore>/etc/hosts.deny</ignore>
        <ignore>/etc/mail/statistics</ignore>
        <ignore>/etc/random-seed</ignore>
        <ignore>/etc/adjtime</ignore>
        <ignore>/etc/httpd/logs</ignore>
        <ignore type="sregex">.log$|.swp$</ignore>

        <nodiff>/etc/ssl/private.key</nodiff>
        <skip_nfs>yes</skip_nfs>
      </syscheck>

      <!-- Unified Logging. The .pkg does NOT configure this out of the box,
           and on current macOS it is where the security-relevant events are;
           /var/log/system.log is close to empty now.

           The predicate is deliberately narrow. An open query on a laptop
           produces a firehose, and hoophq's indexer runs on a 2 GB heap with
           30 day retention; see the footprint note in ../hoophq/wazuh.nix.
           Widen it when hunting something specific, not by default. -->
      <localfile>
        <location>macos</location>
        <log_format>macos</log_format>
        <query type="trace,activity,log" level="info">(process == "sudo") or (process == "su") or (process == "sshd") or (process == "securityd") or (process == "authd") or (process == "loginwindow") or (process == "screensharingd") or (process == "sandboxd") or (eventMessage CONTAINS "authentication failure") or (eventMessage CONTAINS "Failed to authenticate")</query>
      </localfile>

      <logging>
        <log_format>plain</log_format>
      </logging>

    </ossec_config>
  '';
in
{
  # nix-darwin has no services.wazuh-agent to hook into and no launchd daemon is
  # declared here on purpose: the .pkg ships its own
  # /Library/LaunchDaemons/com.wazuh.agent.plist, whose Label is com.wazuh.agent
  # and which runs /Library/Ossec/Wazuh-launcher. Declaring a second
  # org.nixos.* daemon for the same binaries would mean two supervisors
  # fighting over one agent.
  #
  # postActivation runs as root at the end of every darwin-rebuild switch.
  # Everything below is guarded so a no-change rebuild touches nothing and,
  # crucially, does not restart the agent -- an unguarded `installer` here
  # would reinstall on every single rebuild.
  system.activationScripts.postActivation.text = ''
    echo "setting up the Wazuh agent (pinned ${version})" >&2

    wazuhNeedsRestart=no

    # ------------------------------------------------------------ package ----
    # VERSION.json is at the root of /Library/Ossec, not under etc/, and the
    # postinstall leaves it mode 440 owned wazuh:wazuh -- readable here because
    # activation is root.
    wazuhInstalled=""
    if [ -r ${ossecDir}/VERSION.json ]; then
      wazuhInstalled=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        ${ossecDir}/VERSION.json | head -1)
    fi

    if [ "$wazuhInstalled" = "${version}" ] && [ -x ${ossecDir}/bin/wazuh-control ]; then
      echo "  wazuh-agent ${version} already installed" >&2
    else
      if [ -n "$wazuhInstalled" ]; then
        echo "  upgrading wazuh-agent $wazuhInstalled -> ${version}" >&2
      else
        echo "  installing wazuh-agent ${version}" >&2
      fi
      # No /tmp/wazuh_envs. Those variables exist only to seed ossec.conf and
      # authd.pass, both of which are written below from sources that are not
      # world-readable /tmp.
      /usr/sbin/installer -pkg ${agentPkg} -target /
      wazuhNeedsRestart=yes
    fi

    # --------------------------------------------------------- the CA cert ----
    # Public, so it is fine for this to be a plain readable file.
    if [ -r ${stagedCa} ]; then
      if ! cmp -s ${stagedCa} ${ossecDir}/etc/wazuh-ca.pem; then
        cp ${stagedCa} ${ossecDir}/etc/wazuh-ca.pem
        chown root:wazuh ${ossecDir}/etc/wazuh-ca.pem
        chmod 0644 ${ossecDir}/etc/wazuh-ca.pem
        echo "  installed the manager CA" >&2
        wazuhNeedsRestart=yes
      fi
    else
      echo "  WARNING: ${stagedCa} is missing, so the agent cannot verify the" >&2
      echo "           manager and enrollment will fail. See the header of" >&2
      echo "           hosts/mcpro/wazuh-agent.nix." >&2
    fi

    # --------------------------------------------- the enrollment password ----
    if [ -r ${stagedPass} ]; then
      if ! cmp -s ${stagedPass} ${ossecDir}/etc/authd.pass; then
        cp ${stagedPass} ${ossecDir}/etc/authd.pass
        chown root:wazuh ${ossecDir}/etc/authd.pass
        chmod 0640 ${ossecDir}/etc/authd.pass
        echo "  installed the enrollment password" >&2
        wazuhNeedsRestart=yes
      fi
    else
      echo "  WARNING: ${stagedPass} is missing, so enrollment against authd" >&2
      echo "           will be rejected. See the header of" >&2
      echo "           hosts/mcpro/wazuh-agent.nix." >&2
    fi

    # ---------------------------------------------------------- ossec.conf ----
    # root:wazuh 0640, matching what the .pkg's postinstall sets.
    if ! cmp -s ${ossecConf} ${ossecDir}/etc/ossec.conf; then
      cp ${ossecConf} ${ossecDir}/etc/ossec.conf
      chown root:wazuh ${ossecDir}/etc/ossec.conf
      chmod 0640 ${ossecDir}/etc/ossec.conf
      echo "  installed ossec.conf" >&2
      wazuhNeedsRestart=yes
    fi

    # ------------------------------------------------------------- service ----
    # The .pkg does NOT start the daemon on a fresh install -- its postinstall
    # only runs `launchctl bootstrap` when it detects an UPGRADE with a
    # WAZUH_RESTART flag. So bootstrap it here when it is not loaded, and
    # kickstart it when it is and something above changed.
    if /bin/launchctl print system/com.wazuh.agent >/dev/null 2>&1; then
      if [ "$wazuhNeedsRestart" = yes ]; then
        echo "  restarting com.wazuh.agent" >&2
        /bin/launchctl kickstart -k system/com.wazuh.agent
      fi
    else
      echo "  bootstrapping com.wazuh.agent" >&2
      /bin/launchctl bootstrap system /Library/LaunchDaemons/com.wazuh.agent.plist
    fi
  '';
}
